{
	"name": "SpicyAPI: generate an image (HTTP Request)",
	"nodes": [
		{
			"parameters": {
				"content": "## Generate an image with SpicyAPI\n\nUses only built-in nodes, so it also runs on n8n Cloud.\n\n1. Create a **Bearer Auth** credential. Paste a SpicyAPI key from https://spicyapi.ai/console/keys as the token, and select it in the four HTTP Request nodes that call api.spicyapi.ai.\n2. Change the prompt, model or price limit in **Settings**. Model IDs are listed at https://spicyapi.ai/models.\n3. Run the workflow.\n\nEvery run is priced first. If the quote is above `maxCostUsd`, the workflow stops before anything is charged.\n\nResult links expire after about 20 minutes, so the last node downloads the image as a binary file.",
				"width": 420,
				"height": 520
			},
			"id": "5b1c0000-0000-4000-8000-000000000001",
			"name": "About",
			"type": "n8n-nodes-base.stickyNote",
			"typeVersion": 1,
			"position": [
				-420,
				-360
			]
		},
		{
			"parameters": {},
			"id": "5b1c0000-0000-4000-8000-000000000002",
			"name": "Start",
			"type": "n8n-nodes-base.manualTrigger",
			"typeVersion": 1,
			"position": [
				0,
				0
			]
		},
		{
			"parameters": {
				"assignments": {
					"assignments": [
						{
							"id": "5b1c0000-0000-4000-8000-00000000012d",
							"name": "model",
							"value": "alibaba/z-image-turbo/text-to-image",
							"type": "string"
						},
						{
							"id": "5b1c0000-0000-4000-8000-00000000012e",
							"name": "prompt",
							"value": "A ceramic coffee cup on a wooden table, soft window light, product photo",
							"type": "string"
						},
						{
							"id": "5b1c0000-0000-4000-8000-00000000012f",
							"name": "aspectRatio",
							"value": "1:1",
							"type": "string"
						},
						{
							"id": "5b1c0000-0000-4000-8000-000000000130",
							"name": "maxCostUsd",
							"value": 0.5,
							"type": "number"
						}
					]
				},
				"options": {}
			},
			"id": "5b1c0000-0000-4000-8000-000000000003",
			"name": "Settings",
			"type": "n8n-nodes-base.set",
			"typeVersion": 3.4,
			"position": [
				220,
				0
			]
		},
		{
			"parameters": {
				"method": "POST",
				"url": "https://api.spicyapi.ai/api/v1/jobs/quote",
				"options": {},
				"authentication": "genericCredentialType",
				"genericAuthType": "httpBearerAuth",
				"sendBody": true,
				"specifyBody": "json",
				"jsonBody": "={{ JSON.stringify({ model: $json.model, input: { prompt: $('Settings').item.json.prompt, aspect_ratio: $('Settings').item.json.aspectRatio } }) }}"
			},
			"id": "5b1c0000-0000-4000-8000-000000000004",
			"name": "Get Quote",
			"type": "n8n-nodes-base.httpRequest",
			"typeVersion": 4.2,
			"position": [
				440,
				0
			],
			"credentials": {
				"httpBearerAuth": {
					"id": "",
					"name": "SpicyAPI Bearer"
				}
			}
		},
		{
			"parameters": {
				"conditions": {
					"options": {
						"caseSensitive": true,
						"leftValue": "",
						"typeValidation": "strict",
						"version": 2
					},
					"conditions": [
						{
							"id": "5b1c0000-0000-4000-8000-0000000003ed",
							"leftValue": "={{ $json.code === 200 && Number($json.data.maxCharge || $json.data.estimatedCost) <= Number($('Settings').item.json.maxCostUsd) }}",
							"rightValue": "",
							"operator": {
								"type": "boolean",
								"operation": "true",
								"singleValue": true
							}
						}
					],
					"combinator": "and"
				},
				"options": {}
			},
			"id": "5b1c0000-0000-4000-8000-000000000005",
			"name": "Within Budget?",
			"type": "n8n-nodes-base.if",
			"typeVersion": 2.2,
			"position": [
				660,
				0
			]
		},
		{
			"parameters": {
				"errorMessage": "={{ 'The quote of $' + (($json.data && $json.data.estimatedCost) || '?') + ' is above maxCostUsd in Settings. Nothing was charged.' }}"
			},
			"id": "5b1c0000-0000-4000-8000-000000000006",
			"name": "Over Budget",
			"type": "n8n-nodes-base.stopAndError",
			"typeVersion": 1,
			"position": [
				880,
				180
			]
		},
		{
			"parameters": {
				"method": "POST",
				"url": "https://api.spicyapi.ai/api/v1/jobs/createTask",
				"options": {},
				"authentication": "genericCredentialType",
				"genericAuthType": "httpBearerAuth",
				"sendQuery": true,
				"queryParameters": {
					"parameters": [
						{
							"name": "wait",
							"value": "50"
						}
					]
				},
				"sendHeaders": true,
				"headerParameters": {
					"parameters": [
						{
							"name": "Idempotency-Key",
							"value": "={{ 'n8n-' + $execution.id + '-' + $itemIndex }}"
						}
					]
				},
				"sendBody": true,
				"specifyBody": "json",
				"jsonBody": "={{ JSON.stringify({ model: $('Settings').item.json.model, input: { prompt: $('Settings').item.json.prompt, aspect_ratio: $('Settings').item.json.aspectRatio }, quoteId: $json.data.quoteId, expectedCost: $json.data.estimatedCost }) }}"
			},
			"id": "5b1c0000-0000-4000-8000-000000000007",
			"name": "Create Task",
			"type": "n8n-nodes-base.httpRequest",
			"typeVersion": 4.2,
			"position": [
				880,
				-20
			],
			"credentials": {
				"httpBearerAuth": {
					"id": "",
					"name": "SpicyAPI Bearer"
				}
			}
		},
		{
			"parameters": {
				"conditions": {
					"options": {
						"caseSensitive": true,
						"leftValue": "",
						"typeValidation": "strict",
						"version": 2
					},
					"conditions": [
						{
							"id": "5b1c0000-0000-4000-8000-0000000003f0",
							"leftValue": "={{ !['queued', 'running'].includes($json.data.state) && !(($json.data.output && $json.data.output.assets) || []).some(asset => asset.pending && !asset.unavailable) }}",
							"rightValue": "",
							"operator": {
								"type": "boolean",
								"operation": "true",
								"singleValue": true
							}
						}
					],
					"combinator": "and"
				},
				"options": {}
			},
			"id": "5b1c0000-0000-4000-8000-000000000008",
			"name": "Finished?",
			"type": "n8n-nodes-base.if",
			"typeVersion": 2.2,
			"position": [
				1100,
				-20
			]
		},
		{
			"parameters": {
				"amount": 5,
				"unit": "seconds"
			},
			"id": "5b1c0000-0000-4000-8000-000000000009",
			"name": "Wait 5 Seconds",
			"type": "n8n-nodes-base.wait",
			"typeVersion": 1.1,
			"position": [
				1100,
				200
			],
			"webhookId": "5b1c0000-0000-4000-8000-000000000385"
		},
		{
			"parameters": {
				"method": "GET",
				"url": "https://api.spicyapi.ai/api/v1/jobs/recordInfo",
				"options": {},
				"authentication": "genericCredentialType",
				"genericAuthType": "httpBearerAuth",
				"sendQuery": true,
				"queryParameters": {
					"parameters": [
						{
							"name": "taskId",
							"value": "={{ $json.data.taskId }}"
						}
					]
				}
			},
			"id": "5b1c0000-0000-4000-8000-00000000000a",
			"name": "Get Task",
			"type": "n8n-nodes-base.httpRequest",
			"typeVersion": 4.2,
			"position": [
				1320,
				200
			],
			"credentials": {
				"httpBearerAuth": {
					"id": "",
					"name": "SpicyAPI Bearer"
				}
			}
		},
		{
			"parameters": {
				"conditions": {
					"options": {
						"caseSensitive": true,
						"leftValue": "",
						"typeValidation": "strict",
						"version": 2
					},
					"conditions": [
						{
							"id": "5b1c0000-0000-4000-8000-0000000003f3",
							"leftValue": "={{ $json.data.state === 'succeeded' }}",
							"rightValue": "",
							"operator": {
								"type": "boolean",
								"operation": "true",
								"singleValue": true
							}
						}
					],
					"combinator": "and"
				},
				"options": {}
			},
			"id": "5b1c0000-0000-4000-8000-00000000000b",
			"name": "Succeeded?",
			"type": "n8n-nodes-base.if",
			"typeVersion": 2.2,
			"position": [
				1320,
				-20
			]
		},
		{
			"parameters": {
				"errorMessage": "={{ ($json.data.errorCode || $json.data.state) + ': ' + ($json.data.errorMessage || 'the task did not succeed') + ' (task ' + $json.data.taskId + '). Failed tasks are normally not charged.' }}"
			},
			"id": "5b1c0000-0000-4000-8000-00000000000c",
			"name": "Task Failed",
			"type": "n8n-nodes-base.stopAndError",
			"typeVersion": 1,
			"position": [
				1540,
				160
			]
		},
		{
			"parameters": {
				"method": "GET",
				"url": "={{ $json.data.output.assets[0].url }}",
				"options": {
					"response": {
						"response": {
							"responseFormat": "file"
						}
					}
				}
			},
			"id": "5b1c0000-0000-4000-8000-00000000000d",
			"name": "Download Image",
			"type": "n8n-nodes-base.httpRequest",
			"typeVersion": 4.2,
			"position": [
				1540,
				-40
			]
		}
	],
	"connections": {
		"Start": {
			"main": [
				[
					{
						"node": "Settings",
						"type": "main",
						"index": 0
					}
				]
			]
		},
		"Settings": {
			"main": [
				[
					{
						"node": "Get Quote",
						"type": "main",
						"index": 0
					}
				]
			]
		},
		"Get Quote": {
			"main": [
				[
					{
						"node": "Within Budget?",
						"type": "main",
						"index": 0
					}
				]
			]
		},
		"Within Budget?": {
			"main": [
				[
					{
						"node": "Create Task",
						"type": "main",
						"index": 0
					}
				],
				[
					{
						"node": "Over Budget",
						"type": "main",
						"index": 0
					}
				]
			]
		},
		"Create Task": {
			"main": [
				[
					{
						"node": "Finished?",
						"type": "main",
						"index": 0
					}
				]
			]
		},
		"Finished?": {
			"main": [
				[
					{
						"node": "Succeeded?",
						"type": "main",
						"index": 0
					}
				],
				[
					{
						"node": "Wait 5 Seconds",
						"type": "main",
						"index": 0
					}
				]
			]
		},
		"Wait 5 Seconds": {
			"main": [
				[
					{
						"node": "Get Task",
						"type": "main",
						"index": 0
					}
				]
			]
		},
		"Get Task": {
			"main": [
				[
					{
						"node": "Finished?",
						"type": "main",
						"index": 0
					}
				]
			]
		},
		"Succeeded?": {
			"main": [
				[
					{
						"node": "Download Image",
						"type": "main",
						"index": 0
					}
				],
				[
					{
						"node": "Task Failed",
						"type": "main",
						"index": 0
					}
				]
			]
		}
	},
	"settings": {
		"executionOrder": "v1"
	},
	"pinData": {},
